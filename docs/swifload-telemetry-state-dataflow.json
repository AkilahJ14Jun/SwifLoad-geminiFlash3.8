{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "SwifLoad Telemetry & Trip State Data Flow",
    "output": "swifload-telemetry-state-dataflow.html",
    "viewBox": [1080, 780],
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "telemetry-path",
        "label": "GPS telemetry & map pipeline",
        "focus": ["driver_gps", "telemetry_stream", "geo_engine", "map_cache", "leaflet_map"],
        "note": "Raw GPS telemetry streams through the Geo Engine, merges with cached CartoDB tiles, and renders on Leaflet radar."
      },
      {
        "id": "trip-state-path",
        "label": "Trip state & client storage",
        "focus": ["booking_events", "trip_events", "logistics_state", "local_storage", "customer_view"],
        "note": "Shipper trip actions mutate the central in-memory state machine and synchronize to localStorage for offline resilience."
      },
      {
        "id": "pricing-finance-path",
        "label": "Pricing & financial ledger",
        "focus": ["admin_ops", "pricing_req", "pricing_engine", "finance_ledger", "admin_dashboard"],
        "note": "Zone surge tariffs and pricing models feed the ledger for payout reconciliation and admin audits."
      }
    ]
  },
  "stages": [
    { "label": "Producers" },
    { "label": "Transit & Ingestion" },
    { "label": "Processing Engines" },
    { "label": "Storage & Caching" },
    { "label": "Consumer Portals" }
  ],
  "nodes": [
    { "id": "driver_gps", "type": "frontend", "label": "Driver GPS", "sublabel": "Capacitor Geolocation", "stage": 0, "row": 0, "tag": "interval: 3s" },
    { "id": "booking_events", "type": "frontend", "label": "Booking Intake", "sublabel": "Shipper UI payload", "stage": 0, "row": 1, "tag": "on-demand" },
    { "id": "admin_ops", "type": "security", "label": "Admin Controls", "sublabel": "Zone & KYC params", "stage": 0, "row": 2, "tag": "privileged" },
    { "id": "telemetry_stream", "type": "messagebus", "label": "telemetry.v1", "sublabel": "GPS & heading bus", "stage": 1, "row": 0, "tag": "real-time" },
    { "id": "trip_events", "type": "messagebus", "label": "trips.v1", "sublabel": "Lifecycle actions", "stage": 1, "row": 1, "tag": "transactional" },
    { "id": "pricing_req", "type": "messagebus", "label": "tariffs.v1", "sublabel": "Zone surge events", "stage": 1, "row": 2, "tag": "config stream" },
    { "id": "geo_engine", "type": "backend", "label": "Geo Engine", "sublabel": "ETA & route projection", "stage": 2, "row": 0, "tag": "stateless" },
    { "id": "logistics_state", "type": "backend", "label": "Logistics State", "sublabel": "Trips & drivers reducer", "stage": 2, "row": 1, "tag": "in-memory" },
    { "id": "pricing_engine", "type": "backend", "label": "Pricing Engine", "sublabel": "Surge & GST compute", "stage": 2, "row": 2, "tag": "pure function" },
    { "id": "map_cache", "type": "cloud", "label": "Map Cache", "sublabel": "CartoDB tile layer", "stage": 3, "row": 0, "tag": "edge cached" },
    { "id": "local_storage", "type": "database", "label": "Persistence", "sublabel": "swifload_trips_v1", "stage": 3, "row": 1, "tag": "client store" },
    { "id": "finance_ledger", "type": "database", "label": "Ledger Store", "sublabel": "Payout & GST records", "stage": 3, "row": 2, "tag": "audit trail" },
    { "id": "leaflet_map", "type": "frontend", "label": "Leaflet Map", "sublabel": "GPS radar canvas", "stage": 4, "row": 0, "tag": "60fps map" },
    { "id": "customer_view", "type": "frontend", "label": "Customer View", "sublabel": "Live tracking UI", "stage": 4, "row": 1, "tag": "shipper app" },
    { "id": "admin_dashboard", "type": "frontend", "label": "Admin Portal", "sublabel": "Operations wall", "stage": 4, "row": 2, "tag": "ops portal" }
  ],
  "flows": [
    { "from": "driver_gps", "to": "telemetry_stream", "label": "GPS fix", "classification": "raw stream", "variant": "emphasis", "route": "straight" },
    { "from": "booking_events", "to": "trip_events", "label": "trip action", "classification": "validated JSON", "variant": "emphasis", "route": "straight" },
    { "from": "admin_ops", "to": "pricing_req", "label": "tariff change", "classification": "admin event", "variant": "default", "route": "straight" },
    { "from": "telemetry_stream", "to": "geo_engine", "label": "filter fixes", "classification": "stream filter", "variant": "emphasis", "route": "straight" },
    { "from": "trip_events", "to": "logistics_state", "label": "mutate state", "classification": "reducer action", "variant": "emphasis", "route": "straight" },
    { "from": "pricing_req", "to": "pricing_engine", "label": "update surge", "classification": "zone multiplier", "variant": "default", "route": "straight" },
    { "from": "logistics_state", "to": "geo_engine", "label": "trip points", "classification": "pickup / drop", "variant": "dashed", "route": "vertical-channel" },
    { "from": "logistics_state", "to": "pricing_engine", "label": "calculate fare", "classification": "sync compute", "variant": "dashed", "route": "vertical-channel" },
    { "from": "geo_engine", "to": "map_cache", "label": "project coords", "classification": "interpolated GPS", "variant": "emphasis", "route": "straight" },
    { "from": "logistics_state", "to": "local_storage", "label": "persist state", "classification": "JSON snapshot", "variant": "emphasis", "route": "straight" },
    { "from": "pricing_engine", "to": "finance_ledger", "label": "split ledger", "classification": "driver 82%", "variant": "emphasis", "route": "straight" },
    { "from": "map_cache", "to": "leaflet_map", "label": "render markers", "classification": "map tiles", "variant": "emphasis", "route": "straight" },
    { "from": "local_storage", "to": "customer_view", "label": "hydrate trips", "classification": "reactive sync", "variant": "emphasis", "route": "straight" },
    { "from": "finance_ledger", "to": "admin_dashboard", "label": "reconcile", "classification": "audit report", "variant": "emphasis", "route": "straight" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Stage-Gated Stream Ingestion",
      "items": [
        "Capacitor GPS emits coordinates at 3-second polling intervals",
        "Telemetry and transactional trip events enter dedicated partitioned channels",
        "Admin parameter changes propagate without blocking active driver streams"
      ]
    },
    {
      "dot": "emerald",
      "title": "Processing & Persistence Boundary",
      "items": [
        "Geo Engine projects interpolated positions and calculates arrival ETAs",
        "React LogisticsContext acts as atomic in-memory state reducer",
        "Browser localStorage guarantees persistence across page reloads and WebView sleep"
      ]
    },
    {
      "dot": "amber",
      "title": "Consumer Rendering & Reconciliation",
      "items": [
        "Leaflet radar canvas updates marker coordinates smoothly",
        "Customer view dynamically reflects OTP verification and driver proximity",
        "Admin portal observes zone revenue, commissions, and CSV audit trails"
      ]
    }
  ]
}
