    "views": [
      {
        "id": "happy-path-rail",
        "label": "Order-to-delivery rail",
        "focus": ["searching", "assigned", "at_pickup", "in_transit", "delivered"],
        "note": "Follow the trip entity across its primary forward state machine from booking to delivery."
      },
      {
        "id": "security-gate",
        "label": "OTP handshake & cancellation",
        "focus": ["at_pickup", "otp_mismatch", "cancelled"],
        "note": "Failed OTP verification stops cargo transit and terminates the trip with cancellation fee calculation."
      },
      {
        "id": "settlement-outcomes",
        "label": "Transit recovery & settlement",
        "focus": ["in_transit", "sos_reroute", "reassigned", "delivered", "audit_hold", "settled"],
        "note": "Separate mid-transit breakdown replacement from final ledger audit and wallet settlement."
      }
    ]
  },
  "lanes": [
    { "id": "main", "label": "Trip Lifecycle Rail" },
    { "id": "waiting", "label": "Security & Audit Gates" },
    { "id": "recovery", "label": "Transit SOS Controller" },
    { "id": "terminal", "label": "Terminal Exits" }
  ],
  "states": [
    { "id": "searching", "type": "start", "label": "SEARCHING", "sublabel": "radar broadcast", "lane": "main", "col": 0, "step": "01", "tag": "pending" },
